{
  "entities": {
    "CareerProfile": {
      "title": "CareerProfile",
      "description": "Player career progression, cash, bounty, won circuits, and 15-rank Blacklist status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "driverName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "cash": {
          "type": "number"
        },
        "totalBounty": {
          "type": "number"
        },
        "blacklistDefeated": {
          "type": "number"
        },
        "racesWon": {
          "type": "number"
        },
        "copsTakedowns": {
          "type": "number"
        },
        "selectedCarId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownedCarIds": {
          "type": "array"
        },
        "wonTrackIds": {
          "type": "array"
        },
        "completedMissionIds": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "driverName",
        "cash",
        "totalBounty",
        "blacklistDefeated",
        "racesWon",
        "copsTakedowns",
        "selectedCarId",
        "ownedCarIds",
        "wonTrackIds",
        "updatedAt"
      ]
    },
    "GarageCarConfig": {
      "title": "GarageCarConfig",
      "description": "Per-vehicle performance upgrades and visual customization.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "carId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "engineLevel": {
          "type": "number"
        },
        "turboLevel": {
          "type": "number"
        },
        "nitrousLevel": {
          "type": "number"
        },
        "tiresLevel": {
          "type": "number"
        },
        "paintHex": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "secondaryHex": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "paintFinish": {
          "type": "string",
          "enum": ["gloss", "metallic", "matte", "pearl", "chrome"]
        },
        "livery": {
          "type": "string",
          "enum": ["clean", "stripes", "most_wanted", "boss_carbon", "two_tone", "cyber_hex", "drift_camo"]
        },
        "bodyKit": {
          "type": "string",
          "enum": ["stock", "street", "widebody", "gt_race"]
        },
        "spoilerStyle": {
          "type": "string",
          "enum": ["auto", "none", "lip", "ducktail", "gt_wing", "chassis_mount"]
        },
        "hoodStyle": {
          "type": "string",
          "enum": ["stock", "vented", "carbon", "twin_intake"]
        },
        "exhaustStyle": {
          "type": "string",
          "enum": ["dual", "quad", "titanium"]
        },
        "rimStyle": {
          "type": "string",
          "enum": ["chrome", "black", "gold", "bronze", "gunmetal", "white"]
        },
        "rimDesign": {
          "type": "string",
          "enum": ["five_spoke", "y_split", "turbofan", "deep_dish"]
        },
        "caliperHex": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "windowTint": {
          "type": "string",
          "enum": ["light", "dark", "limo", "amber_mirror"]
        },
        "headlightTint": {
          "type": "string",
          "enum": ["xenon", "ice_blue", "yellow_gt", "crimson"]
        },
        "underglowHex": {
          "type": "string"
        },
        "stanceHeight": {
          "type": "number"
        },
        "camberDeg": {
          "type": "number"
        },
        "engineSound": {
          "type": "string",
          "enum": ["auto", "i4_turbo", "v6_twin_turbo", "v8_muscle", "v10_screamer", "v12_hyper", "rotary_brap", "flat6_gt", "electric_whine"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "carId",
        "engineLevel",
        "turboLevel",
        "nitrousLevel",
        "tiresLevel",
        "paintHex",
        "livery",
        "rimStyle",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public Most Wanted Rap Sheet entry for cross-player rankings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "driverName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "totalBounty": {
          "type": "number"
        },
        "bestLapMs": {
          "type": "number"
        },
        "highestHeat": {
          "type": "number"
        },
        "blacklistRank": {
          "type": "number"
        },
        "carName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "driverName",
        "totalBounty",
        "bestLapMs",
        "highestHeat",
        "blacklistRank",
        "carName",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/CareerProfile"
      },
      "description": "Private player career progression document keyed by Firebase Auth UID."
    },
    "/users/{userId}/garage/{carId}": {
      "schema": {
        "$ref": "#/entities/GarageCarConfig"
      },
      "description": "Private vehicle tuning and visual config subcollection belonging to a user."
    },
    "/leaderboard/{entryId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Public Most Wanted Rap Sheet leaderboard entry keyed by owner UID."
    }
  }
}
